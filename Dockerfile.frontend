#Build node 22 image under the build name
FROM node:22.10.0-slim AS build

#Get the model run time from the build args
ARG VITE_MODEL_RUN_TIME
ENV VITE_MODEL_RUN_TIME=$VITE_MODEL_RUN_TIME

#Set the working directory 
WORKDIR /app

#Copy only the package files first so the dependency install layer stays cached
COPY ./vue-ui/package.json ./vue-ui/package-lock.json ./

#npm comes with the Node.js image
#Install dependencies (cached unless package.json/package-lock.json change)
#RUN npm install <- will silently install dependencies that don't match package-lock.json
#RUN npm ci <- installs dependencies exactly as specified in package-lock.json
RUN npm ci 

#Copy the rest of the files
COPY ./vue-ui ./

#Build the Vue App
RUN npm run build

#Build the Nginx image to serve static files
#As of 10/31/2024 this is the latest stable version of nginx
FROM nginx:1.26.2 

#Copy the custom nginx.conf
COPY nginx.conf  /etc/nginx/nginx.conf 

#Copy the built files from the previous stage
COPY --from=build /app/dist /usr/share/nginx/html

#Set the working directory 
WORKDIR /app 

# Set up necessary permissions
RUN chown -R nginx:nginx /usr/share/nginx/html && \ 
    chmod -R 755 /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    chown -R nginx:nginx /etc/nginx/conf.d

# Ensure Nginx PID file exists and set permissions       
RUN touch /var/run/nginx.pid && \
        chown -R nginx:nginx /var/run/nginx.pid

# Switch to the nginx user
USER nginx

#Start nginx
CMD ["nginx", "-g", "daemon off;"]