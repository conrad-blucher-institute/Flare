{
    "chart_name": "Magnolia_Water-Level_48hrs",
    "CSPEC_version": "1.0.0",
    "data_requests" : [
        {
            "_comment": "5 days of past water level measurements from hohonu",
            "key": "Hohonu",
            "args": {
                "column_name": "Hohonu-Water-Level-Measurements",
                "station_id": "hohonu-185",
                "datum": "D2W",
                "unit": "english",
                "interval": 3600,
                "range": [-120, 0]
            }
        },
        {
            "_comment": "48 hours of water level predictions",
            "key": "SemaphoreOutputTimeSpan",
            "args": {
                "column_name": "Magnolia-Water-Level-Predictions",
                "range": [1, 48],
                "interval": 3600,
                "model_names": [
                    "magnolia_transform_12",
                    "magnolia_transform_24",
                    "magnolia_transform_48"
                ]
            }
        }
    ],
    "post_processing" : [
        {
            "_comment": "converts magnolia predictions from meters to feet by doing meters * 3.281",
            "key": "ImmediateArithmeticOperation",
            "args": {
                "op": "multiplication",
                "left_col_key": "Magnolia-Water-Level-Predictions",
                "value": 3.281,
                "out_col_key": "Magnolia-Water-Level-Predictions"
            }
        },
        {
            "_comment": "interpolates water level predictions for missing magnolia points up to 6 hours",
            "key": "LinearInterpolation",
            "args": {
                "col_name": "Magnolia-Water-Level-Predictions",
                "interpolation_interval": 3600,
                "limit": 21600
            }
        }
    ],
    "csv_config": {
        "csv_name": "Magnolia_Water-Level_48hrs.csv",
        "included_columns": [
            "Hohonu-Water-Level-Measurements",
            "Magnolia-Water-Level-Predictions"
        ]
    }
}