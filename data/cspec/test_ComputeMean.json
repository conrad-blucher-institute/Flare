{
    "_comment": "This cspec is to test the compute mean post processing class through the flare pipeline",
    "chart_name": "test-compute-mean",
    "CSPEC_version": "1.0.0",
    "data_requests" : [
        {
            "key": "SemaphoreInputs",
            "args": {
                "column_name": "Seadrift Water Temperature Measurement",
                "location": "Seadrift",
                "source": "NOAATANDC",
                "series": "dWaterTmp",
                "interval": 3600,
                "range": [-24, 0]
            }
        },
        {
            "key": "SemaphoreInputs",
            "args": {
                "column_name": "Port O'Connor Water Temperature Measurement",
                "location": "PortOConnor",
                "source": "NOAATANDC",
                "series": "dWaterTmp",
                "interval": 3600,
                "range": [-24, 0]
            }
        },
        {
            "key": "SemaphoreInputs",
            "args": {
                "column_name": "Port Lavaca Water Temperature Measurement",
                "location": "PortLavaca",
                "source": "NOAATANDC",
                "series": "dWaterTmp",
                "interval": 3600,
                "range": [-24, 0]
            }
        },
        {
            "key": "SemaphoreInputs",
            "args": {
                "column_name": "Aransas Wildlife Refuge Water Temperature Measurement",
                "location": "AransasWildlifeRefuge",
                "source": "NOAATANDC",
                "series": "dWaterTmp",
                "interval": 3600,
                "range": [-24, 0]
            }
        }
    ],
    "post_processing" : [
        {
            "key": "ComputeMean",
            "args": {
                "dropOutlierValues": true,
                "thresholdDeviationFromMedian": 3.5,
                "targetSeries": [
                    "Seadrift Water Temperature Measurement",
                    "Port O'Connor Water Temperature Measurement",
                    "Port Lavaca Water Temperature Measurement",
                    "Aransas Wildlife Refuge Water Temperature Measurement"
                ],
                "outKey": "mean water measurements"
            }
        }
    ],
    "csv_config": {
      "csv_name": "test-compute-mean.csv",
      "included_columns": [
        "Seadrift Water Temperature Measurement",
        "Port O'Connor Water Temperature Measurement",
        "Port Lavaca Water Temperature Measurement",
        "Aransas Wildlife Refuge Water Temperature Measurement",
        "mean water measurements"
      ]
    }
}